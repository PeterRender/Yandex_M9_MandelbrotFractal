{
  "name": "Ubuntu25.04 with GCC15",
  "build": {
      "dockerfile": "./Dockerfile",
      "context": ".",
      "args": {
        "USER_UID": "197611",  // явно прописал UID/GID из Git Bash
        "USER_GID": "197121"
      }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "dev",
  "postStartCommand": "conan profile detect || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "vadimcn.vscode-lldb",
        "twxs.cmake",
        "streetsidesoftware.code-spell-checker-russian",
        "streetsidesoftware.code-spell-checker",
        "matepek.vscode-catch2-test-adapter"
      ],
      // Добавил, чтобы clangd работал через clangd-20
        "settings": {
            "clangd.path": "/usr/bin/clangd-20",
            "editor.formatOnSave": true,
            "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
        }
    }
  }
  // Здесь закомментировал (выдавало ошибку при открытии контейнера)
  // "mounts": [
  //   "source=${env:HOME}/.gitconfig,target=/home/dev/.gitconfig,type=bind,consistency=cached",
  //   "source=${env:HOME}/.conan2,target=/home/dev/.conan2,type=bind,consistency=cached"
  // ]
}